/*ARITHMETIC OPERATORS*/
#include<stdio.h>
int main() 
{
int num1, num2;
printf("Enter 1st Number:");
scanf("%d",&num1);
printf("Enter 2nd Number:");
scanf("%d",&num2);
printf("\n----ADDITION OPERATOR----\n");
printf("The Addition of %d and %d is %d\n\n",num1,num2,num1+num2);
printf("\n----SUBSTRUCTION OPERATOR----\n");
printf("The Substruction of %d and %d is %d\n\n",num1,num2,num1-num2);
printf("\n ---- MULTIPICATION OPERATOR----\n");
printf("The Multipication of %d and %d is %d\n\n",num1,num2,num1*num2);
printf("\n ----DIVISION OPERATOR----\n");
printf("The Division of %d and %d is %d\n\n",num1,num2,num1/num2);
printf("\n ---- MODULUS OPERATOR----\n");
printf("The Modulus of %d and %d is %d\n\n",num1,num2,num1%num2);
printf("\n---- INCREMENT OPERATOR----\n");
printf("The pre- Increment of %d  is %d\n\n",num1,++num1);
printf("The post-Increment of %d  is %d\n\n",num1,num1--);
printf("\n---- DECREMENT OPERATOR----");
printf("The pre- Decrement of %d  is %d\n\n",num1,--num1);
printf("The post- Decrement of %d is %d\n\n",num1,num1--);
return 0;

}